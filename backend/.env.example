# LLM Provider API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./fastagent.db

# Vector Database (Optional)
PINECONE_API_KEY=
